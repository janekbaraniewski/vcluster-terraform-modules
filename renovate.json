{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": ["dependencies"],
  "ignorePaths": [
    "**/.terraform/**"
  ],
  "packageRules": [
    {
      "description": "Group all GitHub Actions updates into a single PR",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    },
    {
      "description": "Group OpenTofu provider updates into a single PR",
      "matchManagers": ["terraform"],
      "matchDepTypes": ["provider"],
      "groupName": "terraform-providers"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "OpenTofu version in CI workflows",
      "fileMatch": ["^\\.github/workflows/.+\\.yml$"],
      "matchStrings": ["tofu_version:\\s*\"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "opentofu/opentofu",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ]
}
